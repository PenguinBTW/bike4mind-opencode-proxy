{
  "$schema": "https://opencode.ai/config.json",
  "model": "bike4mind/claude-sonnet-5-5",
  "small_model": "bike4mind/claude-haiku-5-5",
  "provider": {
    "bike4mind": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:BIKE4MIND_API_KEY}",
        "headerTimeout": 600000,
        "chunkTimeout": 600000,
        "timeout": false
      },
      "models": {
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5 (Medium Reasoning)",
          "tools": true
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5 (Fast)",
          "tools": true
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (Deep Reasoning)",
          "tools": true
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview",
          "tools": true
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "tools": true
        },
        "claude-3-5-sonnet": {
          "name": "Claude Sonnet (Alias -> Sonnet 5.5)",
          "tools": true
        },
        "claude-3-5-haiku": {
          "name": "Claude Haiku (Alias -> Haiku 5.5)",
          "tools": true
        }
      }
    }
  }
}
